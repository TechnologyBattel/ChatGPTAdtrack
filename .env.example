# Copy to .env for local development. Never commit .env.
#
# Two kinds of variable live here:
#   VITE_*  — compiled into the browser bundle. PUBLIC. Never put a secret here.
#   server  — read only by the API process (server/server.mjs) or injected as
#             Cloud Run secrets. Never exposed to the browser.
#
# Rules that make the server refuse to start live in server/config.mjs and are
# documented in docs/SECURITY.md. The short version: AUTH_MODE=dev refuses to run
# alongside ad account keys, and production insists on Firebase + Firestore.

# ---------------------------------------------------------------------------
# Browser (public)
# ---------------------------------------------------------------------------
VITE_API_BASE=
VITE_TRACKING_ENDPOINT=/api/track

# ---------------------------------------------------------------------------
# Server: OpenAI Ads (server-only)
# ---------------------------------------------------------------------------
OPENAI_ADS_API_KEY=
OPENAI_CONVERSIONS_API_KEY=
OPENAI_PIXEL_ID=
ACCOUNT_TIMEZONE=Asia/Kolkata
# Set only when lead/order events really flow; otherwise lead, customer and
# revenue columns render as an em dash instead of a fake zero.
FIRST_PARTY_SOURCE=

# ---------------------------------------------------------------------------
# Server: security
# ---------------------------------------------------------------------------
# dev = shared dev token, refuses to start under NODE_ENV=production AND refuses
# to start at all if any OPENAI_* key above is set (dev auth would make the ad
# account writable by anyone who can reach the dev route).
# firebase = Firebase ID tokens via firebase-admin (required in production).
AUTH_MODE=dev
# Blank = generated at startup and printed in the log. Never set this in prod.
DEV_AUTH_TOKEN=
DEV_AUTH_ROLE=owner
FIREBASE_PROJECT_ID=

# Signs consent ids: an ordered list "v2:secret,v1:older". At least 16 chars each.
# CONSENT_SECRET_VERSION picks the signing key (defaults to the first entry), so
# rotation keeps unexpired ids valid. A lone CONSENT_SECRET is still read as v1.
CONSENT_SECRETS=
CONSENT_SECRET_VERSION=
CONSENT_SECRET=
# Consent ids are single use and short lived; sessions are what the page reuses.
CONSENT_TTL_SECONDS=900
SESSION_TTL_SECONDS=1800

# Where sessions, consent records and push history live: memory | firestore.
# memory is refused in production (replay protection must survive a restart).
STORAGE=

# Number of OUR OWN proxy hops in front of the API, counted from the right of
# X-Forwarded-For. 0 ignores the header entirely, which is the safe default.
# Rate limiting keys on the resulting address, so a wrong value lets a client
# choose its own bucket. See docs/SECURITY.md §4.
TRUST_PROXY=0

# Server-to-server event ingest (POST /api/events): leads, orders and amounts.
# Same "v2:secret,v1:older" shape as CONSENT_SECRETS, but each secret must be at
# least 32 chars — this key can write revenue into the ad account. Empty means the
# route answers 503 ingest_not_configured, so unsigned events are never accepted.
# Rotate by adding v2, moving senders, then dropping v1.
INGEST_KEYS=
INGEST_KEY_VERSION=
# Replay window for the signed X-ADTrack-Timestamp header, in seconds.
INGEST_MAX_SKEW_SECONDS=300

# Outbox: events the upstream refused for a retryable reason are queued, not lost.
# Backoff doubles from OUTBOX_BASE_DELAY_MS up to OUTBOX_MAX_DELAY_MS; after
# OUTBOX_MAX_ATTEMPTS the entry is dead-lettered and the audit log records it.
OUTBOX_ENABLED=true
OUTBOX_INTERVAL_MS=30000
OUTBOX_MAX_ATTEMPTS=6
OUTBOX_BASE_DELAY_MS=30000
OUTBOX_MAX_DELAY_MS=1800000

# Retention: purging expired events (13 months) and leads (25 months). The policy
# lives with the store; this only controls the sweep. false disables it entirely.
RETENTION_SWEEP=true
RETENTION_SWEEP_INTERVAL_MS=21600000
# The policy also sweeps spent one-shot OAuth states after 1 day, and rate-limit windows
# after 1 day. Saved research runs and topics are never swept.

# How long SIGTERM waits for in-flight requests before the process stops waiting and
# exits non-zero. Keep it below the platform's stop grace period (30s on most hosts).
SHUTDOWN_TIMEOUT_MS=15000

# Comma-separated origins allowed to POST /api/track and /api/session. Empty means
# no cross-origin tracking at all, which is the safe default. This is NOT CORS:
# the app is served same-origin as the API and calls relative URLs only.
TRACK_ORIGINS=
TRACK_REQUIRE_ORIGIN=false

RATE_LIMIT_PER_MINUTE=60

# Logging. `json` is what staging and production should emit (one line per request, with a
# request id); `text` is for a terminal. Production defaults to json.
LOG_FORMAT=
# A request slower than this is marked `slow: true` so it can be alerted on.
SLOW_REQUEST_MS=2000
MAX_BODY_BYTES=262144

# ---------------------------------------------------------------------------
# Server: runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=8787

# ---------------------------------------------------------------------------
# Browser: Firebase Auth (public values, safe to ship)
# ---------------------------------------------------------------------------
# Set VITE_FIREBASE_API_KEY to turn the login overlay into email/password sign-in
# against Firebase Auth. Left blank, the overlay offers the dev route instead.
# These are the Web SDK values, not service account credentials.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------- connectors
# HubSpot CRM (read-only). All three are required together; with none set the connector
# reports "not configured" and every write route refuses with 503. Requested scopes are
# crm.objects.contacts.read and crm.objects.deals.read and nothing else.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Must match the redirect URL registered on the HubSpot app exactly.
HUBSPOT_REDIRECT_URI=
# Where the browser lands after HubSpot authorizes; it posts {code, state} back to
# POST /api/orgs/:org/workspaces/:ws/connectors/hubspot/connect/complete.
# Token endpoint path. HubSpot is retiring /oauth/v1/token (sunset 2027-02-16); the
# date-based endpoint is the default here and can be overridden during a migration.
HUBSPOT_TOKEN_PATH=/oauth/2026-09/token
HUBSPOT_API_BASE=https://api.hubapi.com
# Webhook deliveries accepted per connection per minute before answering 429 with
# Retry-After. The counter is stored, so the limit holds across instances. 0 disables it
# (single-tenant dev only).
HUBSPOT_WEBHOOK_PER_MINUTE=120

# 32 bytes, base64 (44 chars) or hex (64 chars): seals OAuth access/refresh tokens at
# rest with AES-256-GCM. Generate with: openssl rand -base64 32
CONNECTOR_ENCRYPTION_KEY=

# Public origin of this API, e.g. https://api.example.com. Required for HubSpot webhooks:
# the v3 signature covers the exact URL that HubSpot called, so the server must know it.
PUBLIC_BASE_URL=
