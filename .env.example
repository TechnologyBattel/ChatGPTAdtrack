# Copy to .env for local development. Never commit .env.
#
# Two kinds of variable live here:
#   VITE_*  — compiled into the browser bundle. PUBLIC. Never put a secret here.
#   server  — read only by the API process (server/server.mjs) or injected as
#             Cloud Run secrets. Never exposed to the browser.
#
# Firebase is optional until browser auth is wired in (PLAN.md slice 1); the API
# only needs FIREBASE_PROJECT_ID when AUTH_MODE=firebase.

# ---------------------------------------------------------------------------
# Browser (public)
# ---------------------------------------------------------------------------
VITE_API_BASE=
VITE_TRACKING_ENDPOINT=/api/track

# ---------------------------------------------------------------------------
# Server: OpenAI Ads (server-only)
# ---------------------------------------------------------------------------
OPENAI_ADS_API_KEY=
OPENAI_CONVERSIONS_API_KEY=
OPENAI_PIXEL_ID=
ACCOUNT_TIMEZONE=Asia/Kolkata
# Set only when lead/order events really flow; otherwise lead, customer and
# revenue columns render as an em dash instead of a fake zero.
FIRST_PARTY_SOURCE=

# ---------------------------------------------------------------------------
# Server: security
# ---------------------------------------------------------------------------
# dev = shared dev token, refuses to start under NODE_ENV=production.
# firebase = Firebase ID tokens via firebase-admin (required in production).
AUTH_MODE=dev
DEV_AUTH_TOKEN=
DEV_AUTH_ROLE=owner
FIREBASE_PROJECT_ID=

# Signs consent ids. At least 16 characters. Required in production.
CONSENT_SECRET=
CONSENT_TTL_SECONDS=15552000

# Comma-separated origins allowed to POST /api/track. Empty means no cross-origin
# tracking at all, which is the safe default.
TRACK_ORIGINS=
TRACK_REQUIRE_ORIGIN=false

RATE_LIMIT_PER_MINUTE=60
MAX_BODY_BYTES=262144

# ---------------------------------------------------------------------------
# Server: runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=8787

# ---------------------------------------------------------------------------
# Optional: browser Firebase SDK (only if/when client-side auth is added)
# ---------------------------------------------------------------------------
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
