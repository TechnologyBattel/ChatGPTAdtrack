# ---------------------------------------------------------------------------
# Copy to .env for local dev. Never commit .env.
# Anything prefixed VITE_ is bundled into the browser build: public values only.
# ---------------------------------------------------------------------------

# --- Firebase (browser-safe) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Our API server (browser-safe). Leave blank to use same-origin /api. ---
VITE_API_BASE=
VITE_TRACKING_ENDPOINT=/api/track

# --- OpenAI Ads: browser-safe (the Pixel ID is public by design) ---
VITE_OPENAI_PIXEL_ID=

# ===========================================================================
# SERVER ONLY — read by server/dev.mjs or injected as container/Cloud Function
# secrets. Never put any of these in a VITE_ variable: VITE_ values are public.
# ===========================================================================
OPENAI_ADS_API_KEY=
OPENAI_CONVERSIONS_API_KEY=
OPENAI_PIXEL_ID=
ACCOUNT_TIMEZONE=Asia/Kolkata

# Set only when lead/customer/revenue events really are flowing in;
# without it the UI masks those columns instead of showing a fake ₹0.
FIRST_PARTY_SOURCE=

# --- Server / sync tuning ---
API_PORT=8787
SYNC_REGION=asia-south1
CONSENT_REQUIRED=true
