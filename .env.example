# ---------------------------------------------------------------------------
# Copy to .env for local dev. Never commit .env.
# Anything prefixed VITE_ is bundled into the browser build: public values only.
# ---------------------------------------------------------------------------

# --- Firebase (browser-safe) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Our server (browser-safe) ---
VITE_TRACKING_ENDPOINT=

# --- OpenAI Ads: browser-safe (the Pixel ID is public by design) ---
VITE_OPENAI_PIXEL_ID=

# ===========================================================================
# SERVER ONLY — Cloud Function secrets. Never put these in a VITE_ variable.
#   firebase functions:secrets:set OPENAI_ADS_API_KEY
#   firebase functions:secrets:set OPENAI_CONVERSIONS_API_KEY
#   firebase functions:secrets:set OPENAI_API_KEY        # embeddings for research
# ===========================================================================
OPENAI_ADS_API_KEY=
OPENAI_CONVERSIONS_API_KEY=
OPENAI_API_KEY=

# --- Research / sync tuning ---
SYNC_REGION=asia-south1
CONSENT_REQUIRED=true
